<h1>Other Reports</h1>

<h2>MRR</h2>
<div id="revenuechart"></div>
<script>
Highcharts.chart('revenuechart', {
    chart: {
        type: 'line',
        zoomType: 'x'
    },
    title: {
        text: 'MRR'
    },
    xAxis: {
        categories: <%= @net_income_array[0].to_s.html_safe  %>
    },
    yAxis: {
        title: {
            text: '$'
        }
    },
    plotOptions: {
        line: {
            dataLabels: {
                enabled: true
            },
            enableMouseTracking: false
        }
    },
    series: [{
        name: 'MRR',
        data: <%= @net_income_array[2].to_s.html_safe  %>
    }]
});
</script>

